# Dev only: the manifest "key" (base64 public key), which pins the unpacked
# extension's ID across reloads and machines. Put it in .env.development, not
# .env: store builds must not include a key, and only `pnpm dev` loads that file.
CRX_KEY=

# Set to true to silence console output in all builds
PLASMO_PUBLIC_DISABLE_LOGS=
