{
	"name": "darc",
	"displayName": "Darc",
	"version": "0.1.0",
	"description": "A keyboard-first command palette for your browser. Search tabs, history, bookmarks, and settings, or open any site.",
	"author": "Billy Jacoby",
	"scripts": {
		"dev": "dotenv -e .env -e .env.development -- plasmo dev",
		"build": "dotenv -e .env -- plasmo build && node scripts/on-demand-content-scripts.mjs build/chrome-mv3-prod",
		"build:firefox": "dotenv -e .env -- plasmo build --target=firefox-mv2",
		"build:safari": "dotenv -e .env -- plasmo build --target=safari-mv3",
		"package": "dotenv -e .env -- plasmo build && node scripts/on-demand-content-scripts.mjs build/chrome-mv3-prod && dotenv -e .env -- plasmo package",
		"type-check": "tsc --noEmit",
		"lint": "biome check"
	},
	"dependencies": {
		"@plasmohq/messaging": "^0.7.1",
		"@plasmohq/storage": "^1.15.0",
		"@tanstack/react-query": "^5.80.10",
		"kbar": "0.1.0-beta.45",
		"lucide-react": "^0.522.0",
		"plasmo": "0.90.5",
		"react": "18.2.0",
		"react-dom": "18.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.0",
		"@ianvs/prettier-plugin-sort-imports": "4.1.1",
		"@types/chrome": "0.0.258",
		"@types/node": "20.11.5",
		"@types/react": "18.2.48",
		"@types/react-dom": "18.2.18",
		"autoprefixer": "^10.4.21",
		"dotenv": "^16.5.0",
		"dotenv-cli": "^8.0.0",
		"postcss": "^8.5.6",
		"prettier": "3.2.4",
		"tailwindcss": "^3.4.17",
		"typescript": "5.3.3"
	},
	"manifest": {
		"browser_specific_settings": {
			"gecko": {
				"id": "darc@billyjacoby.dev"
			}
		},
		"key": "$CRX_KEY",
		"permissions": [
			"tabs",
			"storage",
			"history",
			"topSites",
			"scripting",
			"activeTab",
			"bookmarks",
			"favicon"
		],
		"web_accessible_resources": [
			{
				"resources": [
					"_favicon/*"
				],
				"matches": [
					"<all_urls>"
				]
			}
		],
		"commands": {
			"open_palette": {
				"suggested_key": {
					"default": "Ctrl+Shift+P",
					"mac": "Command+Shift+P"
				},
				"description": "Open command palette"
			}
		}
	}
}
